<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8+). minSdk is 29, so this is what every
     supported device actually renders — the mipmap-*/ic_launcher.png files are
     only a fallback for tooling that predates adaptive icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/gengar_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
